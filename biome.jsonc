{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"assist": {
		"actions": {
			"preset": "recommended",
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!node_modules",
			"!.next",
			"!dist",
			"!build",
			"!cloudflare-env.d.ts",
			"!**/*.grit"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"domains": {
			"next": "all",
			"playwright": "all",
			"react": "all",
			"test": "all"
		},
		"enabled": true,
		"rules": {
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": { "maxAllowedComplexity": 10 }
				},
				"noExcessiveLinesPerFunction": {
					"level": "warn",
					"options": {
						"maxLines": 80,
						"skipBlankLines": true,
						"skipIifes": true
					}
				}
			},
			"preset": "recommended",
			"style": {
				"useComponentExportOnlyModules": "off",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"],
						"requireAscii": true,
						"strictCase": true
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.{test,spec}.{ts,tsx}"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": { "level": "off" }
					}
				}
			}
		}
	],
	"plugins": [
		"./plugins/enforce-automocking.grit",
		"./plugins/enforce-aaa-assertions.grit"
	],
	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
