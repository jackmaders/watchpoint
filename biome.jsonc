{
	"$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
	"assist": {
		"actions": {
			"preset": "recommended",
			"source": {
				"organizeImports": "on",
				"useSortedAttributes": "on",
				"useSortedKeys": "on",
				"useSortedProperties": "on"
			}
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!node_modules",
			"!.next",
			"!.output",
			"!.nitro",
			"!.vinxi",
			"!dist",
			"!build",
			"!storybook-static",
			"!cloudflare-env.d.ts",
			"!app/routeTree.gen.ts",
			"!drizzle/meta",
			"!**/*.grit"
		]
	},
	"formatter": {
		"enabled": true
	},
	"linter": {
		"domains": {
			"playwright": "all",
			"react": "all",
			"test": "all"
		},
		"enabled": true,
		"rules": {
			"complexity": {
				"noExcessiveCognitiveComplexity": {
					"level": "warn",
					"options": { "maxAllowedComplexity": 10 }
				},
				"noExcessiveLinesPerFunction": {
					"level": "warn",
					"options": {
						"maxLines": 80,
						"skipBlankLines": true,
						"skipIifes": true
					}
				}
			},
			"preset": "recommended",
			"style": {
				"useComponentExportOnlyModules": "off",
				"useFilenamingConvention": {
					"level": "error",
					"options": {
						"filenameCases": ["kebab-case"],
						"requireAscii": true,
						"strictCase": true
					}
				}
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/*.{test,spec}.{ts,tsx}"],
			"linter": {
				"rules": {
					"complexity": {
						"noExcessiveLinesPerFunction": { "level": "off" }
					}
				}
			}
		},
		{
			"includes": ["app/routes/**", "app/routeTree.gen.ts"],
			"linter": {
				"rules": {
					"style": {
						"useFilenamingConvention": "off"
					}
				}
			}
		}
	],
	"plugins": [
		"./plugins/enforce-automocking.grit",
		"./plugins/enforce-aaa-assertions.grit",
		{
			"includes": [
				"**/*.jsx",
				"**/*.tsx",
				"!**/__mocks__/**",
				"!**/__tests__/**",
				"!**/*.test.jsx",
				"!**/*.test.tsx",
				"!**/*.spec.jsx",
				"!**/*.spec.tsx",
				"!**/generated/**"
			],
			"path": "./plugins/enforce-no-production-testid.grit"
		},
		{
			"includes": [
				"app/routes/**/*.tsx",
				"app/routes/**/*.ts",
				"!app/routes/__root.tsx",
				"!app/routes/**/__tests__/**"
			],
			"path": "./plugins/enforce-ultra-thin-routes.grit"
		}
	],

	"vcs": {
		"clientKind": "git",
		"enabled": true,
		"useIgnoreFile": true
	}
}
