{
	"$schema": "../node_modules/wrangler/config-schema.json",
	"name": "watchpoint",
	"compatibility_date": "2026-09-19",
	"compatibility_flags": ["nodejs_compat"],
	"main": "../src/app/server.ts",
	"observability": { "enabled": true },
	"workers_dev": true,
	"vars": {
		"BETTER_AUTH_URL": "https://watchpoint.jackmaders.workers.dev"
	},
	"secrets": {
		"required": ["BETTER_AUTH_SECRET", "SENTRY_DSN"]
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "f7d563c1-aa9f-4a83-9efb-3d379b263821",
			"database_name": "watchpoint-db",
			"migrations_dir": "../drizzle",
			"migrations_pattern": "../drizzle/*/migration.sql"
		}
	]
}
