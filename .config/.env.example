BETTER_AUTH_SECRET="replace-with-a-long-random-secret"
BETTER_AUTH_URL="http://localhost:5173"

# Sentry is disabled by default in local development. Set both variables to the
# same public DSN to capture Worker and browser errors locally.
# SENTRY_DSN="https://public-key@o0.ingest.sentry.io/0"
# VITE_SENTRY_DSN="https://public-key@o0.ingest.sentry.io/0"
