{
	"root": false,
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true,
		"root": "."
	},
	"files": {
		"includes": [
			"**",
			"!**/dist",
			"!**/.wrangler",
			"!**/drizzle",
			"!**/test-results",
			"!**/src/routeTree.gen.ts",
			"!**/src/cloudflare-env.d.ts"
		]
	},
	"formatter": { "enabled": true },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended"
		}
	},
	"assist": {
		"enabled": true,
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	}
}
