# Sandcastle Environment Variables Example
# Host Google subscription tokens and credentials mounted automatically from ~/.gemini
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=
CODEX_PROVIDER=openrouter
CODEX_MODEL=
# Required for the default Codex queue path. openrouter/free is a dynamic,
# best-effort router; use --model <provider/model> when reproducibility matters.
ANTHROPIC_API_KEY=
GITHUB_TOKEN=
GH_TOKEN=
