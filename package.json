{
	"dependencies": {
		"@opennextjs/cloudflare": "^1.20.2",
		"@prisma/adapter-d1": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@radix-ui/react-slot": "^1.3.3",
		"@tanstack/react-form": "^1.33.3",
		"better-auth": "^1.6.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.28.0",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@cloudflare/workers-types": "^5.20260804.1",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.10",
		"happy-dom": "^20.11.1",
		"lefthook": "^1.11.3",
		"prisma": "^7.9.1",
		"steiger": "^0.6.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.10",
		"wrangler": "^4.119.0"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"name": "watchpoint",
	"packageManager": "bun@1.3.13",
	"prisma": {
		"seed": "bun prisma/seed.ts"
	},
	"private": true,
	"scripts": {
		"build": "next build",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv --include-runtime false cloudflare-env.d.ts && bun scripts/patch-cf-types.ts",
		"check:all": "biome check --error-on-warnings .",
		"check:architecture": "steiger ./src",
		"check:cf-sync": "bun scripts/check-cf-sync.ts",
		"check:db-drift": "bun scripts/check-db-drift.ts",
		"check:format": "biome format --error-on-warnings .",
		"check:lint": "biome lint --error-on-warnings .",
		"check:prisma-sync": "bun scripts/check-prisma-sync.ts",
		"check:seed": "bun prisma/seed.ts",
		"check:types": "tsc --noEmit",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:new": "bunx prisma migrate dev --create-only",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote",
		"db:status:local": "wrangler d1 migrations list DB --local",
		"db:status:prod": "wrangler d1 migrations list DB --remote",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"dev": "next dev",
		"fix:all": "biome check --write --unsafe --error-on-warnings .",
		"prepare": "lefthook install",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"prisma": "bunx --bun prisma",
		"prisma:seed": "bun prisma/seed.ts",
		"prisma:validate": "bunx --bun prisma validate",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"validate": "bun run check:types && bun run check:all && bun run check:architecture && bun run test:coverage && bun run build"
	},
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"type": "module",
	"version": "0.1.0"
}
