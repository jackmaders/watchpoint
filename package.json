{
	"dependencies": {
		"@opennextjs/cloudflare": "^1.20.2",
		"@radix-ui/react-slot": "^1.3.3",
		"@sentry/nextjs": "^10.69.0",
		"@tanstack/react-form": "^1.33.3",
		"better-auth": "^1.6.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"drizzle-orm": "^0.45.2",
		"lucide-react": "^1.28.0",
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@ai-hero/sandcastle": "^0.12.0",
		"@biomejs/biome": "^2.5.7",
		"@cloudflare/workers-types": "^5.20260804.1",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@playwright/test": "^1.62.1",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/bun": "^1.3.14",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.10",
		"drizzle-kit": "^0.31.10",
		"happy-dom": "^20.11.1",
		"lefthook": "^1.11.3",
		"steiger": "^0.6.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vitest": "^4.1.10",
		"wrangler": "^4.119.0"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"name": "watchpoint",
	"packageManager": "bun@1.3.13",
	"private": true,
	"scripts": {
		"build": "next build",
		"build:worker": "opennextjs-cloudflare build",
		"cf-typegen": "wrangler types cloudflare-env.d.ts --env-interface CloudflareEnv --include-runtime false --env-file .env.example",
		"check:all": "biome check --error-on-warnings .",
		"check:architecture": "steiger ./src",
		"check:bundle-size": "bunx bundlewatch --config .bundlewatch.config.json",
		"check:cf-sync": "bun run cf-typegen && git diff --exit-code -- cloudflare-env.d.ts",
		"check:drizzle-sync": "bun run db:generate && git diff --exit-code -- drizzle",
		"check:format": "biome format --error-on-warnings .",
		"check:lint": "biome lint --error-on-warnings .",
		"check:seed": "bun scripts/seed.ts",
		"check:types": "tsc --noEmit",
		"db:generate": "drizzle-kit generate",
		"db:migrate:local": "wrangler d1 migrations apply DB --local",
		"db:migrate:prod": "wrangler d1 migrations apply DB --remote",
		"db:seed": "bun scripts/seed.ts",
		"db:status:local": "wrangler d1 migrations list DB --local",
		"db:status:prod": "wrangler d1 migrations list DB --remote",
		"db:studio": "drizzle-kit studio",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"deploy:worker": "wrangler deploy",
		"dev": "next dev",
		"fix:all": "biome check --write --unsafe --error-on-warnings .",
		"prepare": "lefthook install",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"sandcastle": "bun scripts/sandcastle.ts",
		"test:coverage": "vitest run --coverage",
		"test:e2e": "playwright test",
		"test:unit": "vitest run",
		"validate": "bun run check:types && bun run check:all && bun run check:architecture && bun run test:coverage && bun run build"
	},
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"type": "module",
	"version": "0.1.0"
}
