{
	"dependencies": {
		"@prisma/adapter-pg": "^7.9.1",
		"@prisma/client": "^7.9.1",
		"@radix-ui/react-slot": "^1.3.3",
		"better-auth": "^1.6.26",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^1.28.0",
		"next": "16.3.0",
		"pg": "^8.22.0",
		"react": "19.2.8",
		"react-dom": "19.2.8",
		"tailwind-merge": "^3.6.0",
		"tw-animate-css": "^1.4.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@tailwindcss/postcss": "^4",
		"@testing-library/jest-dom": "^7.0.0",
		"@testing-library/react": "^16.3.2",
		"@types/node": "^20",
		"@types/pg": "^8.20.4",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"@vitest/coverage-v8": "^4.1.10",
		"happy-dom": "^20.11.1",
		"prisma": "^7.9.1",
		"steiger": "^0.6.0",
		"tailwindcss": "^4",
		"typescript": "^5",
		"vite-tsconfig-paths": "^6.1.1",
		"vitest": "^4.1.10"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"name": "watchpoint",
	"packageManager": "bun@1.3.13",
	"private": true,
	"scripts": {
		"build": "next build",
		"check:all": "biome check --error-on-warnings .",
		"check:architecture": "steiger ./src",
		"check:format": "biome format --error-on-warnings .",
		"check:lint": "biome lint --error-on-warnings .",
		"dev": "next dev",
		"fix:all": "biome check --write --unsafe --error-on-warnings .",
		"prisma": "bunx --bun prisma",
		"prisma:validate": "bunx --bun prisma validate",
		"start": "next start",
		"test:coverage": "vitest run --coverage",
		"test:unit": "vitest run"
	},
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"type": "module",
	"version": "0.1.0"
}
