{
	"dependencies": {
		"next": "16.3.0",
		"react": "19.2.8",
		"react-dom": "19.2.8"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.7",
		"@feature-sliced/steiger-plugin": "^0.7.0",
		"@tailwindcss/postcss": "^4",
		"@types/node": "^20",
		"@types/react": "^19",
		"@types/react-dom": "^19",
		"steiger": "^0.6.0",
		"tailwindcss": "^4",
		"typescript": "^5"
	},
	"ignoreScripts": [
		"sharp",
		"unrs-resolver"
	],
	"name": "watchpoint",
	"packageManager": "bun@1.3.13",
	"private": true,
	"scripts": {
		"build": "next build",
		"check:all": "biome check --error-on-warnings .",
		"check:architecture": "steiger ./src",
		"check:format": "biome format --error-on-warnings .",
		"check:lint": "biome lint --error-on-warnings .",
		"dev": "next dev",
		"fix:all": "biome check --write --unsafe --error-on-warnings .",
		"start": "next start"
	},
	"trustedDependencies": [
		"sharp",
		"unrs-resolver"
	],
	"version": "0.1.0"
}
