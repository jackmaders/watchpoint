{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"assets": {
		"binding": "ASSETS",
		"directory": "dist/client"
	},
	"compatibility_date": "2026-08-07",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "f7d563c1-aa9f-4a83-9efb-3d379b263821",
			"database_name": "watchpoint-db",
			"migrations_dir": "drizzle",
			"migrations_pattern": "drizzle/*.sql"
		}
	],
	"main": "dist/server/server.js",
	"name": "watchpoint",
	"observability": {
		"enabled": true
	},
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "watchpoint-media"
		}
	],
	"workers_dev": true
}
