{
	"$schema": "./node_modules/wrangler/config-schema.json",
	"assets": {
		"binding": "ASSETS",
		"directory": ".open-next/assets"
	},
	"compatibility_date": "2026-08-06",
	"compatibility_flags": ["nodejs_compat"],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "local-watchpoint-db",
			"database_name": "watchpoint-db"
		}
	],
	"main": ".open-next/worker.js",
	"name": "watchpoint",
	"r2_buckets": [
		{
			"binding": "STORAGE",
			"bucket_name": "watchpoint-assets"
		}
	]
}
